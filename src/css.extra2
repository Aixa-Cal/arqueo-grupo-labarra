.grid3{display:grid;grid-template-columns:repeat(3,minmax(0,1fr));gap:8px}
.fchips{display:flex;gap:6px;overflow-x:auto;padding:6px 0 2px;-webkit-overflow-scrolling:touch}
.tchip.sm{min-height:36px;padding:4px 12px;font-size:.84rem;white-space:nowrap;flex:0 0 auto}
.tchip.sm small{opacity:.75;font-weight:500;margin-left:2px}
.fbox{display:flex;flex-direction:column;gap:6px;margin:4px 0 10px}
.fchips{margin:0 -2px;padding-left:2px;padding-right:2px}
.bar .back{white-space:nowrap;flex:0 0 auto}
.bar .bar-row .sub{min-width:0;overflow:hidden;text-overflow:ellipsis;white-space:nowrap}
.bar .chip{flex:0 0 auto}
/* espaciado entre bloques de cada pantalla */
main#view{display:flex;flex-direction:column;gap:14px}
main#view>*{min-width:0}
.fbox{margin:0}
.tw{margin:0}
.panel>.tw{margin:4px 0 0}
.stat{gap:12px}
.pitem{padding:14px 16px}
.hoyrow{padding:10px 0}
.savemsg{min-height:1.2em}
[hidden]{display:none!important}
input.ro{background:var(--line);color:var(--muted);border-style:dashed}
.grid2{display:grid;grid-template-columns:repeat(2,minmax(0,1fr));gap:8px}
.chk{display:flex;align-items:center;gap:10px;width:100%;min-height:46px;padding:8px 12px;margin:6px 0;border-radius:12px;border:2px solid var(--line);background:var(--surface);font-size:.95rem;text-align:left}
.chk .bx{flex:none;width:24px;height:24px;border-radius:7px;border:2px solid var(--line);display:grid;place-items:center;font-weight:800}
.chk.on{border-color:var(--brand)}.chk.on .bx{background:var(--brand);border-color:var(--brand);color:var(--brand-ink)}
.upill.supervisor{background:#e8e4ff;color:#4b3bb5}
.wabox{display:flex;flex-wrap:wrap;gap:6px;margin-top:8px}
.btn.wa{background:#1f9d55;color:#fff;border-color:#1f9d55;text-decoration:none;display:inline-flex;align-items:center}
.brand img{width:34px;height:36px;border-radius:50%;flex:none}

/* Temas por negocio: Car Wash (azul) y Zona Presidente (neón verde sobre negro) */
:root[data-neg="cw"]{--brand:#1A5FC8;--brand-ink:#FFFFFF;--bg:#F2F6FC;--line:#D6E0F0;--field:#EAF0F9;--ink:#0F1E3A;--muted:#52627F;--accent:#F5B82E}
:root[data-neg="zp"]{--bg:#F4F9F5;--surface:#FFFFFF;--ink:#0E1F14;--muted:#4F6757;--line:#D3E4D8;--field:#EAF3ED;--brand:#14803A;--brand-ink:#FFFFFF;--accent:#F0A62B;--ok:#23724A;--ok-bg:#DAF1E3;--warn:#7D5600;--warn-bg:#FFEDB8;--crit:#A8302A;--crit-bg:#F9D9D4;color-scheme:light}
@media (prefers-color-scheme: dark){:root[data-neg="cw"]:not([data-theme="light"]){--bg:#08101F;--surface:#101C33;--ink:#E8EFFC;--muted:#A5B6D4;--line:#1F3254;--field:#17263F;--brand:#5B9BFF;--brand-ink:#06172E}}
.brand img.zpl{width:auto;height:38px;max-width:200px;border-radius:8px;object-fit:contain;background:#000}

/* Pendientes y avisos: agrupados por día, sin ruido */
.psec{display:flex;flex-direction:column;gap:8px}
.psec h2,.psec summary{font-size:1.05rem;font-weight:800;display:flex;align-items:center;gap:8px;margin:6px 0 0}
.psec h2 span,.psec summary span,.dayh span{background:var(--field);color:var(--muted);border-radius:99px;padding:1px 9px;font-size:.78rem;font-weight:700}
.psec summary{cursor:pointer;list-style:none;padding:12px 2px;min-height:44px}
.psec summary::-webkit-details-marker{display:none}
.psec summary::after{content:"▾";margin-left:auto;color:var(--muted)}
.psec[open] summary::after{content:"▴"}
.psec .hint{margin:0 0 2px}
.dayh{display:flex;align-items:center;gap:8px;margin:10px 2px 0;font-size:.85rem;color:var(--muted)}
.dayh b{font-weight:700;text-transform:capitalize}
.pitem b{font-size:1rem}
.ni .nbody{flex:1;min-width:0}
.ni .nbody small{display:-webkit-box;-webkit-line-clamp:2;-webkit-box-orient:vertical;overflow:hidden}
.ni .when{font-size:.78rem;color:var(--muted);white-space:nowrap}
.dayd{display:flex;flex-direction:column;gap:8px}
.dayd>summary{cursor:pointer;list-style:none;min-height:44px;margin:6px 0 0}
.dayd>summary::-webkit-details-marker{display:none}
.dayd>summary::after{content:"▾";margin-left:auto;color:var(--muted)}
.dayd[open]>summary::after{content:"▴"}
.datebar{display:flex;flex-direction:column;gap:6px}
.dbrow{display:flex;flex-direction:column;gap:8px;align-items:stretch}
.dpick{position:relative;display:flex;align-items:center;justify-content:space-between;gap:8px;min-height:48px;border:2px solid var(--line);background:var(--field);border-radius:10px;padding:10px 12px;width:100%;cursor:pointer}
.dpick:focus-within{border-color:var(--brand)}
.dptxt{font-weight:600}
.dpic{color:var(--brand);flex:none}
.dpin{position:absolute;inset:0;width:100%;height:100%;opacity:0;cursor:pointer;border:0;padding:0}
.dpin::-webkit-calendar-picker-indicator{position:absolute;inset:0;width:100%;height:100%;cursor:pointer}

.nav .in.n6{grid-template-columns:repeat(6,1fr);gap:2px}.nav .in.n6 button{font-size:10px;padding-left:0;padding-right:0}
.althw{display:flex;gap:8px;flex-wrap:wrap;margin:8px 0}.alth{position:relative}.alth img{width:92px;height:92px;object-fit:cover;border-radius:10px}.alth .rx{position:absolute;top:-6px;right:-6px}.alfoto{display:block;width:100%;max-width:420px;border-radius:10px;margin:6px 0}
.chips2{display:flex;flex-wrap:wrap;gap:6px;margin-top:6px}.chips2 .tchip.on{background:#B3261E;color:#fff;border-color:#B3261E}

/* Mi semana */
.sem-hero{display:flex;gap:14px;align-items:center;border-radius:16px;padding:16px;border:1px solid var(--line)}
.sem-hero .big{flex:none;width:56px;height:56px;border-radius:50%;display:grid;place-items:center;font-family:var(--font-display);font-size:1.6rem;font-weight:800}
.sem-hero h2{font-size:1.15rem;margin:0 0 2px}.sem-hero p{margin:0;color:var(--muted);font-size:.92rem}
.sem-hero.ok{background:var(--ok-bg)}.sem-hero.ok .big{background:var(--ok);color:#fff}
.sem-hero.bad{background:var(--crit-bg)}.sem-hero.bad .big{background:var(--crit);color:#fff}
.sem-bar{height:10px;border-radius:99px;background:var(--line);overflow:hidden;margin-top:12px}.sem-bar span{display:block;height:100%;background:var(--ok);border-radius:99px;transition:width .3s}
.sem-barp{margin:6px 0 0;color:var(--muted);font-size:.85rem}
.sem-lista h2,.sem-card h2{font-size:1.05rem;margin:0}
.sem-lista{display:grid;gap:10px}
.sem-acc{display:flex;gap:12px;align-items:center;justify-content:space-between;background:var(--surface);border:1px solid var(--line);border-left:6px solid var(--warn);border-radius:12px;padding:12px 14px}
.sem-acc.bad{border-left-color:var(--crit)}
.sem-at{min-width:0}.sem-at b{display:block}.sem-at small{display:block;color:var(--muted);font-size:.84rem}
.sem-acc .btn.small{width:auto;min-height:44px;flex:none;padding:8px 14px;font-size:.95rem}
.sem-card{background:var(--surface);border:1px solid var(--line);border-radius:16px;padding:14px;display:grid;gap:12px}
.sem-h{display:flex;justify-content:space-between;gap:10px;align-items:flex-start}.sem-h small{color:var(--muted);font-size:.84rem}
.sem-dias{display:grid;grid-template-columns:repeat(7,minmax(0,1fr));gap:6px}
.sem-d{border:1px solid var(--line);border-radius:12px;background:var(--bg);min-height:64px;padding:6px 2px;display:grid;gap:4px;place-items:center;align-content:center}
.sem-d i{font-style:normal;font-size:.78rem;color:var(--muted);font-weight:700}
.sem-d b{font-size:1.05rem;font-weight:800;white-space:nowrap}
.sem-d.hoy{outline:2px solid var(--accent);outline-offset:1px}
.sem-d.k-ok,.sem-d.k-ini{background:var(--ok-bg);color:var(--ok);border-color:transparent}
.sem-d.k-ventas{background:var(--warn-bg);color:var(--warn);border-color:transparent}
.sem-d.k-falta{background:var(--crit-bg);color:var(--crit);border-color:transparent}
.sem-d.k-hoy,.sem-d.k-na{color:var(--muted)}
.sem-ley{display:flex;flex-wrap:wrap;gap:6px 14px;font-size:.84rem;color:var(--muted)}
.sem-ley b{display:inline-block;min-width:18px;text-align:center;font-weight:800}
.sem-ley .k-ok b{color:var(--ok)}.sem-ley .k-ventas b{color:var(--warn)}.sem-ley .k-falta b{color:var(--crit)}
.sem-g{display:flex;justify-content:space-between;gap:10px;align-items:center;min-height:44px;border-top:1px solid var(--line);padding-top:8px}
.sem-g .btn.small{width:auto;min-height:40px;padding:6px 14px}
.pill.mute{background:var(--line);color:var(--muted)}
.sem-link{display:flex;justify-content:space-between;align-items:center;width:100%;min-height:48px;border:1px solid var(--line);background:var(--surface);border-radius:12px;padding:10px 14px;font-weight:700;text-align:left}.sem-link span{color:var(--brand)}
.sem-ayuda{background:var(--surface);border:1px solid var(--line);border-radius:16px;padding:4px 14px}
.sem-ayuda summary{min-height:52px;display:flex;align-items:center;font-weight:800;cursor:pointer}
.sem-pasos{margin:0 0 10px;padding-left:22px;display:grid;gap:10px}
.sem-nota{background:var(--bg);border-radius:12px;padding:12px;margin:0 0 12px;font-size:.9rem;line-height:1.5;color:var(--muted)}
.lg-ayuda{background:var(--field);border-radius:12px;padding:12px 14px;font-size:.92rem;line-height:1.45}.lg-ayuda p{margin:4px 0 0;color:var(--muted)}
.eq-b{display:flex;gap:8px;flex:none}.eq-b .btn.small{min-height:44px}
.eq-enlace{border:2px solid var(--ok)}.btn.wa{display:flex;align-items:center;justify-content:center;text-decoration:none;background:#1FA855;color:#fff}

.guia{position:fixed;inset:0;z-index:50;background:rgba(20,10,10,.55);display:grid;place-items:center;padding:16px}
.guia-box{position:relative;background:var(--surface);border-radius:24px;padding:28px 22px 22px;width:100%;max-width:420px;text-align:center;display:grid;gap:12px}
.guia-e{font-size:4.5rem;line-height:1}
.guia-box h2{font-size:1.5rem;margin:0}.guia-box p{font-size:1.15rem;line-height:1.5;margin:0}
.guia-x{position:absolute;top:8px;right:8px;width:44px;height:44px;border:0;background:transparent;font-size:1.3rem;color:var(--muted)}
.guia-dots{display:flex;justify-content:center;gap:8px;margin:4px 0}.guia-dots i{width:10px;height:10px;border-radius:50%;background:var(--line)}.guia-dots i.on{background:var(--brand);width:26px;border-radius:6px}
.guia-b{display:grid;grid-auto-flow:column;grid-auto-columns:1fr;gap:10px}
.guia-btn{border:2px solid var(--brand);background:transparent;color:var(--brand);border-radius:12px;min-height:48px;font-weight:700;font-size:1rem;padding:10px 14px;width:100%;margin-top:10px}
.ley{background:var(--surface);border:1px solid var(--line);border-radius:14px;padding:12px 14px;display:grid;gap:6px;font-size:1rem}
.ley p{margin:0;line-height:1.4}.ley-t{display:flex;justify-content:space-between;align-items:center}
.ley-t .linkbtn{font-weight:700;color:var(--brand)}
.f span{font-size:.95rem}.f input{min-height:58px;font-size:1.4rem}
.pcard h3{font-size:1.1rem}

/* Contador con − y + */
.stp{display:flex;gap:6px;align-items:stretch}
.stp input{flex:1 1 auto;min-width:0;padding:6px 2px}
.sb{flex:0 0 44px;min-height:58px;border:0;border-radius:12px;background:var(--brand);color:#fff;font-size:1.7rem;font-weight:800;line-height:1;display:grid;place-items:center;-webkit-tap-highlight-color:transparent;touch-action:manipulation}
.sb:active{transform:scale(.94);filter:brightness(.9)}
.f label{display:block;text-align:center}
.grid3{grid-template-columns:1fr}
.grid3 .f{flex-direction:row;align-items:center;justify-content:space-between;gap:10px}
.grid3 .f label{flex:1}.grid3 .f label span{text-align:left}
.grid3 .stp{flex:0 0 64%}
.g1{grid-template-columns:1fr}
.pcard{padding:12px;gap:8px}
.pcard.s-ok{background:color-mix(in srgb,var(--ok) 9%,var(--surface))}
.pcard.s-crit{background:color-mix(in srgb,var(--crit) 8%,var(--surface))}
.res:empty{display:none}.note:empty{display:none}
.meter{height:12px}
.savemsg{font-weight:600}
.stp{gap:4px}.sb{flex:0 0 38px;font-size:1.5rem;border-radius:10px}
.sb[data-d="-1"]{background:var(--field);color:var(--brand);border:2px solid var(--line)}
.stp input{font-size:1.5rem}
