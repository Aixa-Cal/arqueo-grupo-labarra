.grid3{display:grid;grid-template-columns:repeat(3,minmax(0,1fr));gap:8px}
.fchips{display:flex;gap:6px;overflow-x:auto;padding:6px 0 2px;-webkit-overflow-scrolling:touch}
.tchip.sm{min-height:36px;padding:4px 12px;font-size:.84rem;white-space:nowrap;flex:0 0 auto}
.tchip.sm small{opacity:.75;font-weight:500;margin-left:2px}
.fbox{display:flex;flex-direction:column;gap:6px;margin:4px 0 10px}
.fchips{margin:0 -2px;padding-left:2px;padding-right:2px}
.bar .back{white-space:nowrap;flex:0 0 auto}
.bar .bar-row .sub{min-width:0;overflow:hidden;text-overflow:ellipsis;white-space:nowrap}
.bar .chip{flex:0 0 auto}
/* espaciado entre bloques de cada pantalla */
main#view{display:flex;flex-direction:column;gap:14px}
main#view>*{min-width:0}
.fbox{margin:0}
.tw{margin:0}
.panel>.tw{margin:4px 0 0}
.stat{gap:12px}
.pitem{padding:14px 16px}
.hoyrow{padding:10px 0}
.savemsg{min-height:1.2em}
[hidden]{display:none!important}
input.ro{background:var(--line);color:var(--muted);border-style:dashed}
.grid2{display:grid;grid-template-columns:repeat(2,minmax(0,1fr));gap:8px}
.chk{display:flex;align-items:center;gap:10px;width:100%;min-height:46px;padding:8px 12px;margin:6px 0;border-radius:12px;border:2px solid var(--line);background:var(--surface);font-size:.95rem;text-align:left}
.chk .bx{flex:none;width:24px;height:24px;border-radius:7px;border:2px solid var(--line);display:grid;place-items:center;font-weight:800}
.chk.on{border-color:var(--brand)}.chk.on .bx{background:var(--brand);border-color:var(--brand);color:var(--brand-ink)}
.upill.supervisor{background:#e8e4ff;color:#4b3bb5}
.wabox{display:flex;flex-wrap:wrap;gap:6px;margin-top:8px}
.btn.wa{background:#1f9d55;color:#fff;border-color:#1f9d55;text-decoration:none;display:inline-flex;align-items:center}
.brand img{width:34px;height:36px;border-radius:50%;flex:none}

/* Temas por negocio: Car Wash (azul) y Zona Presidente (neón verde sobre negro) */
:root[data-neg="cw"]{--brand:#1A5FC8;--brand-ink:#FFFFFF;--bg:#F2F6FC;--line:#D6E0F0;--field:#EAF0F9;--ink:#0F1E3A;--muted:#52627F;--accent:#F5B82E}
:root[data-neg="zp"]{--bg:#F4F9F5;--surface:#FFFFFF;--ink:#0E1F14;--muted:#4F6757;--line:#D3E4D8;--field:#EAF3ED;--brand:#14803A;--brand-ink:#FFFFFF;--accent:#F0A62B;--ok:#23724A;--ok-bg:#DAF1E3;--warn:#7D5600;--warn-bg:#FFEDB8;--crit:#A8302A;--crit-bg:#F9D9D4;color-scheme:light}
@media (prefers-color-scheme: dark){:root[data-neg="cw"]:not([data-theme="light"]){--bg:#08101F;--surface:#101C33;--ink:#E8EFFC;--muted:#A5B6D4;--line:#1F3254;--field:#17263F;--brand:#5B9BFF;--brand-ink:#06172E}}
.brand img.zpl{width:auto;height:38px;max-width:200px;border-radius:8px;object-fit:contain;background:#000}

/* Pendientes y avisos: agrupados por día, sin ruido */
.psec{display:flex;flex-direction:column;gap:8px}
.psec h2,.psec summary{font-size:1.05rem;font-weight:800;display:flex;align-items:center;gap:8px;margin:6px 0 0}
.psec h2 span,.psec summary span,.dayh span{background:var(--field);color:var(--muted);border-radius:99px;padding:1px 9px;font-size:.78rem;font-weight:700}
.psec summary{cursor:pointer;list-style:none;padding:12px 2px;min-height:44px}
.psec summary::-webkit-details-marker{display:none}
.psec summary::after{content:"▾";margin-left:auto;color:var(--muted)}
.psec[open] summary::after{content:"▴"}
.psec .hint{margin:0 0 2px}
.dayh{display:flex;align-items:center;gap:8px;margin:10px 2px 0;font-size:.85rem;color:var(--muted)}
.dayh b{font-weight:700;text-transform:capitalize}
.pitem b{font-size:1rem}
.ni .nbody{flex:1;min-width:0}
.ni .nbody small{display:-webkit-box;-webkit-line-clamp:2;-webkit-box-orient:vertical;overflow:hidden}
.ni .when{font-size:.78rem;color:var(--muted);white-space:nowrap}
.dayd{display:flex;flex-direction:column;gap:8px}
.dayd>summary{cursor:pointer;list-style:none;min-height:44px;margin:6px 0 0}
.dayd>summary::-webkit-details-marker{display:none}
.dayd>summary::after{content:"▾";margin-left:auto;color:var(--muted)}
.dayd[open]>summary::after{content:"▴"}
.datebar{display:flex;flex-direction:column;gap:6px}
.dbrow{display:flex;gap:8px;align-items:center}
.dbrow input[type=date],#f-desde,#f-hasta{min-height:48px;flex:1}
