/* Layout: app de una columna para celular (máx. 640px). Contar en pantalla completa, con barra de navegación inferior para Resultados y Productos. */
:root{
  --bg:#F3F6F1; --surface:#FFFFFF; --ink:#16231E; --muted:#58675F; --line:#D9E2DB; --field:#EEF2EC;
  --brand:#1B6B55; --brand-ink:#FFFFFF; --accent:#F0A62B;
  --ok:#23724A; --ok-bg:#DAF1E3; --warn:#7D5600; --warn-bg:#FFEDB8; --crit:#A8302A; --crit-bg:#F9D9D4;
  --font-display:'Archivo',system-ui,sans-serif; --font-body:'Public Sans',system-ui,sans-serif;
}
@media (prefers-color-scheme: dark){
  :root:not([data-theme="light"]){
    --bg:#0F1814; --surface:#17241F; --ink:#E7EFE9; --muted:#9DB0A6; --line:#2A3B33; --field:#1F2F28;
    --brand:#4FBF9F; --brand-ink:#07201A; --accent:#F2B24C;
    --ok:#74D6A0; --ok-bg:#1B3A2A; --warn:#F2C655; --warn-bg:#3B3114; --crit:#FF9488; --crit-bg:#45221F; color-scheme:dark;
  }
}
:root[data-theme="dark"]{
  --bg:#0F1814; --surface:#17241F; --ink:#E7EFE9; --muted:#9DB0A6; --line:#2A3B33; --field:#1F2F28;
  --brand:#4FBF9F; --brand-ink:#07201A; --accent:#F2B24C;
  --ok:#74D6A0; --ok-bg:#1B3A2A; --warn:#F2C655; --warn-bg:#3B3114; --crit:#FF9488; --crit-bg:#45221F; color-scheme:dark;
}
*{box-sizing:border-box}
body{background:var(--bg);color:var(--ink);font-family:var(--font-body);font-size:16px;line-height:1.45;
  padding-left:max(16px,env(safe-area-inset-left,0px));padding-right:max(16px,env(safe-area-inset-right,0px));padding-block:12px 110px}
body::before{content:"";position:fixed;inset:0 0 auto;height:env(safe-area-inset-top,0px);z-index:10;background:var(--bg)}
.wrap{max-width:640px;margin:0 auto;display:flex;flex-direction:column;gap:16px}
h1,h2,h3{font-family:var(--font-display);margin:0;text-wrap:balance;letter-spacing:-.01em}
h1{font-size:1.65rem;font-weight:800;line-height:1.15}
h2{font-size:1.2rem;font-weight:700}
h3{font-size:1.05rem;font-weight:700}
p{margin:0}
button,input,select,textarea{font:inherit;color:inherit}
button{cursor:pointer}
:focus-visible{outline:3px solid var(--accent);outline-offset:2px}
.top{display:flex;align-items:center;justify-content:space-between;gap:12px}
.brand{font-family:var(--font-display);font-weight:800;font-size:1.05rem;letter-spacing:.02em}
.chip{font-size:.78rem;font-weight:600;padding:4px 10px;border-radius:99px;background:var(--field);color:var(--muted);white-space:nowrap}
.chip.live{background:var(--ok-bg);color:var(--ok)}
.banner{background:var(--warn-bg);color:var(--warn);padding:10px 12px;border-radius:10px;font-size:.92rem}
.banner.bad{background:var(--crit-bg);color:var(--crit)}
.sub{color:var(--muted);font-size:.95rem}
.panel{background:var(--surface);border:1px solid var(--line);border-radius:14px;padding:16px;display:flex;flex-direction:column;gap:14px}
.lbl{font-size:.8rem;font-weight:700;text-transform:uppercase;letter-spacing:.06em;color:var(--muted)}
.negs{display:grid;grid-template-columns:repeat(2,minmax(0,1fr));gap:10px}
.neg{min-height:64px;text-align:left;padding:12px 14px;border-radius:12px;border:2px solid var(--line);background:var(--surface);display:flex;flex-direction:column;gap:2px;font-weight:700}
.neg small{font-weight:500;color:var(--muted);font-size:.8rem}
.neg.on{border-color:var(--brand);background:var(--field)}
.neg.done small{color:var(--ok)}
.turnos{display:flex;flex-wrap:wrap;gap:8px}
.tchip{min-height:44px;padding:8px 14px;border-radius:99px;border:2px solid var(--line);background:var(--surface);font-weight:600;font-size:.92rem}
.tchip.on{border-color:var(--brand);background:var(--brand);color:var(--brand-ink)}
.row2{display:grid;grid-template-columns:repeat(auto-fit,minmax(180px,1fr));gap:12px}
.field{display:flex;flex-direction:column;gap:6px;min-width:0}
.field input,.field select,.field textarea{min-height:48px;border:2px solid var(--line);background:var(--field);border-radius:10px;padding:10px 12px;width:100%}
.field textarea{min-height:110px;resize:vertical}
.btn{min-height:52px;border:0;border-radius:12px;background:var(--brand);color:var(--brand-ink);font-weight:700;font-size:1.05rem;padding:12px 18px;width:100%}
.btn:disabled{opacity:.45;cursor:not-allowed}
.btn.ghost{background:transparent;color:var(--ink);border:2px solid var(--line)}
.btn.small{min-height:40px;font-size:.92rem;width:auto;padding:8px 14px}
.btn.danger{background:var(--crit);color:#fff}
.bar{position:sticky;top:env(safe-area-inset-top,0px);z-index:5;background:var(--bg);padding:8px 0;display:flex;flex-direction:column;gap:8px}
.bar-row{display:flex;align-items:center;justify-content:space-between;gap:10px}
.back{border:0;background:transparent;color:var(--brand);font-weight:700;padding:8px 0;min-height:40px}
.meter{height:8px;background:var(--line);border-radius:99px;overflow:hidden}
.meter i{display:block;height:100%;background:var(--brand);width:0;transition:width .2s}
.help{background:var(--surface);border:1px solid var(--line);border-radius:12px;padding:10px 14px;font-size:.92rem}
.help summary{font-weight:600;cursor:pointer;min-height:28px}
.help ul{margin:8px 0 0;padding-left:18px;color:var(--muted)}
.pcard{background:var(--surface);border:2px solid var(--line);border-radius:14px;padding:14px;display:flex;flex-direction:column;gap:10px}
.pcard.s-ok{border-color:var(--ok)}
.pcard.s-rev{border-color:var(--accent)}
.pcard.s-crit{border-color:var(--crit)}
.cat{font-size:.82rem;text-transform:uppercase;letter-spacing:.06em;color:var(--muted);padding-top:10px}
.srch{min-height:44px;border:2px solid var(--line);background:var(--field);border-radius:10px;padding:8px 12px;width:100%}
.rline{display:grid;grid-template-columns:minmax(0,1fr) 96px 44px;gap:8px;align-items:center;background:var(--surface);border:1px solid var(--line);border-radius:12px;padding:8px 10px}
.rline small{display:block;color:var(--muted);font-size:.82rem}
.rline input{min-height:48px;width:100%;text-align:center;font-size:1.15rem;font-weight:700;border:2px solid var(--line);background:var(--field);border-radius:10px}
.rx{min-height:44px;border:0;background:transparent;color:var(--muted);font-size:1.2rem}
.rres{min-height:48px;text-align:left;padding:10px 12px;border-radius:10px;border:2px solid var(--line);background:var(--surface);font-weight:600;width:100%}
.rres small{color:var(--muted);font-weight:500;margin-left:6px}
.erow{display:flex;flex-direction:column;gap:2px;border-top:1px solid var(--line);padding-top:8px}
.erow small{color:var(--muted)}
.tag.crit{background:var(--crit-bg);color:var(--crit)}
.calrow{display:flex;flex-direction:column;gap:8px;padding:10px 0;border-top:1px solid var(--line)}
.dchips{display:grid;grid-template-columns:repeat(7,minmax(0,1fr));gap:6px}
.dchip{min-height:44px;border-radius:10px;border:2px solid var(--line);background:var(--surface);font-weight:700;font-size:.78rem;padding:0}
.dchip.on{background:var(--brand);border-color:var(--brand);color:var(--brand-ink)}
.phead{display:flex;align-items:baseline;justify-content:space-between;gap:10px}
.unit{font-size:.85rem;color:var(--muted);font-weight:600}
.grid4{display:grid;grid-template-columns:repeat(4,minmax(0,1fr));gap:8px}
.f{display:flex;flex-direction:column;gap:4px;min-width:0}
.f span{font-size:.78rem;font-weight:600;color:var(--muted);text-align:center}
.f input{width:100%;min-height:52px;text-align:center;font-size:1.2rem;font-weight:700;border:2px solid var(--line);background:var(--field);border-radius:10px;padding:6px 4px;font-variant-numeric:tabular-nums}
.res{font-size:.95rem;display:flex;flex-wrap:wrap;gap:6px 10px;align-items:center;min-height:28px}
.hint,.note{color:var(--muted);font-size:.85rem}
.pill{display:inline-block;font-size:.78rem;font-weight:700;padding:3px 10px;border-radius:99px}
.pill.ok{background:var(--ok-bg);color:var(--ok)}
.pill.rev{background:var(--warn-bg);color:var(--warn)}
.pill.crit{background:var(--crit-bg);color:var(--crit)}
.savebar{position:fixed;left:0;right:0;bottom:0;background:var(--surface);border-top:1px solid var(--line);z-index:6;
  padding:10px max(16px,env(safe-area-inset-left,0px)) calc(10px + env(safe-area-inset-bottom,0px))}
.savebar .in{max-width:640px;margin:0 auto;display:flex;flex-direction:column;gap:6px}
.savemsg{font-size:.85rem;color:var(--muted);text-align:center}
.nav{position:fixed;left:0;right:0;bottom:0;background:var(--surface);border-top:1px solid var(--line);z-index:6;
  padding:6px max(8px,env(safe-area-inset-left,0px)) calc(6px + env(safe-area-inset-bottom,0px))}
.nav .in{max-width:640px;margin:0 auto;display:grid;grid-template-columns:repeat(4,1fr);gap:4px}
.nav button{border:0;background:transparent;min-height:54px;border-radius:10px;display:flex;flex-direction:column;align-items:center;justify-content:center;gap:2px;font-size:.78rem;font-weight:600;color:var(--muted)}
.nav button.on{color:var(--brand);background:var(--field)}
.nav svg{width:22px;height:22px;fill:none;stroke:currentColor;stroke-width:2;stroke-linecap:round;stroke-linejoin:round}
.today{display:flex;flex-wrap:wrap;gap:8px}
.tb{font-size:.85rem;font-weight:600;padding:6px 12px;border-radius:99px;background:var(--field);color:var(--muted)}
.tb.ok{background:var(--ok-bg);color:var(--ok)}
.kpis{display:grid;grid-template-columns:repeat(3,minmax(0,1fr));gap:0}
.kpi{padding:2px 10px;border-left:1px solid var(--line);min-width:0}
.kpi:first-child{border-left:0;padding-left:0}
.kpi b{display:block;font-family:var(--font-display);font-size:1.45rem;font-weight:800;font-variant-numeric:tabular-nums;line-height:1.2}
.kpi span{font-size:.78rem;color:var(--muted)}
.cnt{background:var(--surface);border:1px solid var(--line);border-radius:12px;padding:4px 14px}
.cnt summary{list-style:none;cursor:pointer;padding:10px 0;display:flex;flex-direction:column;gap:6px;min-height:48px}
.cnt summary::-webkit-details-marker{display:none}
.cnt .l1{display:flex;justify-content:space-between;gap:8px;font-weight:700}
.cnt .l2{display:flex;flex-wrap:wrap;gap:6px;align-items:center;font-size:.85rem;color:var(--muted)}
.tw{overflow-x:auto;margin:4px 0 10px}
table{border-collapse:collapse;width:100%;font-size:.88rem}
th{text-align:left;font-size:.75rem;text-transform:uppercase;letter-spacing:.05em;color:var(--muted);padding:6px 8px 6px 0;white-space:nowrap}
td{padding:7px 8px 7px 0;border-top:1px solid var(--line);vertical-align:middle}
td.n,th.n{text-align:right;font-variant-numeric:tabular-nums;padding-right:10px}
.plist{display:flex;flex-direction:column;gap:8px}
.pitem{background:var(--surface);border:1px solid var(--line);border-radius:12px;padding:12px 14px;display:flex;justify-content:space-between;gap:12px;align-items:center}
.pitem div{min-width:0}
.pitem small{display:block;color:var(--muted);font-size:.82rem}
.tag{font-size:.7rem;font-weight:700;background:var(--warn-bg);color:var(--warn);padding:2px 8px;border-radius:99px;margin-left:6px}
.chips{display:flex;flex-wrap:wrap;gap:8px}
.big{font-size:3rem;line-height:1}
.center{text-align:center;align-items:center}
.btnrow{display:flex;gap:10px;flex-wrap:wrap}
.btnrow .btn{flex:1 1 140px}
#toast{position:fixed;left:50%;transform:translateX(-50%);bottom:calc(96px + env(safe-area-inset-bottom,0px));background:var(--ink);color:var(--bg);padding:10px 16px;border-radius:10px;z-index:20;font-size:.92rem;max-width:90vw}
@media (max-width:360px){.negs{grid-template-columns:1fr}}
@media (prefers-reduced-motion:reduce){*{transition:none!important}}
